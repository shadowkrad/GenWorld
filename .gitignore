# Ambiente
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.spec

# Mondi generati e cache dell'analisi: si rifanno in un minuto con
#   python esempi/genera_mappa.py
# e pesano piu' di tutto il resto del progetto messo insieme.
mondi/*
!mondi/*.png

# ...tranne i confronti che hanno DENTRO le mappe originali. Non basta non
# pubblicare l'immagine di partenza: un render che la mostra in un pannello
# accanto al risultato la ridistribuisce lo stesso, in piccolo.
mondi/ansalon_costa.png
mondi/ansalon_guidato.png
mondi/ansalon_profilo.png
mondi/ansalon_regolarizzato.png
mondi/arda_confronto.png
mondi/fiumi_calcolati.png
mondi/fiumi_estratti.png
mondi/fiumi_tre_mappe.png
mondi/profili_faerun_italia.png
mondi/prova_5_mappe.png
mondi/zona_dubbia.png

# Mappe di prova: sono opere di altri (Ansalon e Faerun sono di Wizards of
# the Coast, le carte fisiche hanno il loro editore). Il programma non ne ha
# bisogno per funzionare - se ne carica una qualunque - e ridistribuirle qui
# non sarebbe corretto.
input/*
!input/*.profilo.json
!input/README.md

# Cartella di lavoro di Cowork
Claude outputs/

# Script di servizio, usa e getta: servono sul PC, non nel repository
pubblica_su_github.bat
togli_mappe_altrui.bat

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Copertura dei test
.coverage
htmlcov/

# Template scaricati o acquistati (case, cimiteri, portali, castelli, navi...):
# restano SOLO sul disco di chi li usa, mai nel repository - sono lavoro di
# altri e il repository e' pubblico. Del contenuto di ogni cartella non si
# pubblica niente: si pubblica la struttura (il `.gitkeep` e un `LEGGIMI.md`
# che dice cosa ci va dentro). `templates/case` e' un'altra cosa: sono case
# esportate dal generatore stesso, e restano tracciate.
templates/strutture/*
templates/cimiteri/*
templates/portali/*
templates/altro/*
templates/castelli/*
templates/navi/*
templates/navi_inutilizzate/*
templates/moli/*
templates/fari/*
!templates/*/.gitkeep
!templates/*/LEGGIMI.md
